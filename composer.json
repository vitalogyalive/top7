{
    "name": "top7/top7",
    "description": "Top7 - Le Jeu de Pronostic du Top14",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Top7\\": "www/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Top7\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    }
}
